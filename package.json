{
  "name": "loleanding",
  "version": "0.7.1",
  "description": "League of Legends match history tracker for every queue, born from ARAM Mayhem",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --win",
    "preversion": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.widget.json --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen:augments": "node scripts/generate-augment-descriptions.mjs",
    "build:widget": "tsc -p tsconfig.widget.json",
    "predev": "npm run build:widget",
    "prebuild": "npm run build:widget",
    "predist": "npm run build:widget",
    "test:widget": "npm run build:widget && node --test tests/widget.test.cjs",
    "test:aram": "node scripts/test-aram.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "league-connect": "^6.0.0-rc13"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.loleanding.app",
    "productName": "LoLeanding",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "assets/icon.png",
      "assets/tray.png",
      "assets/tray@2x.png",
      "!node_modules/better-sqlite3/{deps,src}",
      "!node_modules/better-sqlite3/prebuilds/*.node",
      "node_modules/better-sqlite3/prebuilds/win32-${arch}.node",
      "!**/node_modules/node-addon-api/**",
      "public-widget/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "npmRebuild": false,
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "artifactName": "LoLeanding.exe"
    },
    "portable": {
      "unpackDirName": true
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
